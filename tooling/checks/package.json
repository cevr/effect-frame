{
  "name": "@effect-frame/toolchain-checks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/codec-probe.ts",
    "./boundary": "./src/boundary.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build src/codec-probe.ts --target browser --outdir dist",
    "test": "bun test tests/",
    "boundary": "bun run src/boundary-cli.ts",
    "declarations": "bun run src/declarations-cli.ts && tsc -p consumer"
  },
  "devDependencies": {
    "effect-frame": "workspace:*"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
