{
  "name": "effect-frame-host-durable-object-proof",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "no_bundle": true,
  "durable_objects": {
    "bindings": [{ "name": "ACTOR", "class_name": "FrameActor" }],
