{
  "name": "effect-frame-host-durable-object-conformance",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "no_bundle": true,
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "ConformanceObject" }],
