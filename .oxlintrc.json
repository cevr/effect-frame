{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "plugins": ["typescript", "unicorn", "oxc", "import", "node"],
  "jsPlugins": ["oxlint-plugin-effect/plugin"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],
    "import/no-duplicates": "error",
    "node/no-process-env": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-underscore-dangle": "off",
    "unicorn/consistent-function-scoping": "off",
    "no-nested-ternary": "error",
    "complexity": [
      "error",
      {
        "max": 21
      }
    ],
    "effect/maxCognitiveComplexity": [
      "error",
      {
        "max": 21
      }
    ],
    "effect/maxHalsteadDifficulty": [
      "error",
      {
        "max": 79
      }
    ],
    "effect/noAs": "error",
    "effect/noAsyncFunction": "error",
    "effect/noChainedTypeAssertions": "error",
    "effect/noConditionalEmptyObjectSpread": "error",
    "effect/noDynamicImports": "error",
    "effect/noEffectBind": "error",
    "effect/noEffectDo": "error",
    "effect/noGlobals": "error",
    "effect/noInlineProvide": "error",
    "effect/noKnownValueWidening": "error",
    "effect/noManagedRuntimeInEffect": "error",
    "effect/noModuleMocks": "error",
    "effect/noNestedEffectGen": "error",
    "effect/noNewError": "error",
    "effect/noNewPromise": "error",
    "effect/noNodeBuiltinImport": "error",
    "effect/noNullish": "error",
    "effect/noObjectParameters": "error",
    "effect/noPerCallCacheConstruction": "error",
    "effect/noRunCollectOnUnboundedStream": "error",
    "effect/noRuntimeTypeof": "error",
    "effect/noSequentialEffectAll": "error",
    "effect/noShapeInSymbolNames": "error",
    "effect/noSilentCatchAll": "error",
    "effect/noTernary": "error",
    "effect/noTestLifecycleHooks": "error",
    "effect/noThrowStatement": "error",
    "effect/noTryCatch": "error",
    "effect/noUnboundedConcurrency": "error",
    "effect/noUnboundedRetry": "error",
    "effect/noUnknownParameters": "error",
    "effect/noUnknownTypeAliases": "error",
    "effect/noUnsafeDictionaryType": "error",
    "effect/noWidenThenAssert": "error",
    "effect/preferCatchTag": "error",
    "effect/preferEffectFn": "error",
    "effect/preferMatchTagsExhaustive": "error",
    "effect/preferPredicateIsTagged": "error",
    "effect/preferServiceOf": "error",
    "effect/requireNamedEffectFn": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "**/*.server",
              "**/*.server.js",
              "**/*.server.jsx",
              "**/*.server.ts",
              "**/*.server.tsx"
            ],
            "message": "Only a server module or a server entry may import a server module. `bun run boundary` proves the whole graph."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/host-durable-object/tests/sqlite-storage.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noNewPromise": "off",
        "effect/noNullish": "off",
        "effect/noRuntimeTypeof": "off",
        "effect/noUnknownParameters": "off"
      }
    },
    {
      "files": ["packages/host-durable-object/fixture-conformance/index.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noNewPromise": "off",
        "effect/noGlobals": "off",
        "effect/noNullish": "off",
        "effect/noRuntimeTypeof": "off",
        "effect/noUnknownParameters": "off"
      }
    },
    {
      "files": ["packages/host-durable-object/tests/workerd-conformance.test.ts"],
      "rules": {
        "effect/noGlobals": "off",
        "effect/noNodeBuiltinImport": "off"
      }
    },
    {
      "files": ["packages/host-durable-object/fixture/index.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noNullish": "off",
        "effect/noUnknownParameters": "off"
      }
    },
    {
      "files": ["packages/host-durable-object/src/durable-object.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noUnknownParameters": "off"
      }
    },
    {
      "files": ["packages/host-durable-object/src/frame-host.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noUnknownParameters": "off"
      }
    },
    {
      "files": ["packages/host-durable-object/src/route.ts"],
      "rules": {
        "effect/noNewPromise": "off"
      }
    },
    {
      "files": ["packages/host-durable-object/src/interop.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noRuntimeTypeof": "off"
      }
    },
    {
      "files": ["packages/host-durable-object/src/storage.ts"],
      "rules": {
        "effect/noUnsafeDictionaryType": "off"
      }
    },
    {
      "files": ["packages/host-durable-object/tests/storage-store.test.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noNewPromise": "off"
      }
    },
    {
      "files": ["packages/host-durable-object/tests/frame-host.test.ts"],
      "rules": {
        "effect/noGlobals": "off",
        "effect/noUnknownParameters": "off"
      }
    },
    {
      "files": ["packages/host-durable-object/scripts/contract-proof.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off",
        "effect/noNodeBuiltinImport": "off",
        "effect/noTryCatch": "off",
        "effect/noUnknownParameters": "off"
      }
    },
    {
      "files": ["packages/host-durable-object/scripts/crash-harness.ts"],
      "rules": {
        "effect/noAs": "off",
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off",
        "effect/noNewPromise": "off",
        "effect/noNodeBuiltinImport": "off",
        "effect/noNullish": "off",
        "effect/noRuntimeTypeof": "off",
        "effect/noTernary": "off",
        "effect/noTryCatch": "off",
        "effect/noUnknownParameters": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["packages/host-durable-object/scripts/celld-process.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off",
        "effect/noNewError": "off",
        "effect/noNewPromise": "off",
        "effect/noNodeBuiltinImport": "off",
        "effect/noNullish": "off",
        "effect/noThrowStatement": "off",
        "effect/noTryCatch": "off",
        "no-await-in-loop": "off",
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["packages/host-durable-object/scripts/proof.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off",
        "effect/noNewError": "off",
        "effect/noNewPromise": "off",
        "effect/noNodeBuiltinImport": "off",
        "effect/noNullish": "off",
        "effect/noRuntimeTypeof": "off",
        "effect/noTernary": "off"
      }
    },
    {
      "files": ["packages/host-durable-object/scripts/runtimes.ts"],
      "rules": {
        "effect/noNewError": "off",
        "effect/noNullish": "off",
        "effect/noTernary": "off",
        "effect/noThrowStatement": "off"
      }
    },
    {
      "files": ["packages/host-durable-object/scripts/workerd-process.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off",
        "effect/noNewError": "off",
        "effect/noNewPromise": "off",
        "effect/noNodeBuiltinImport": "off",
        "effect/noTernary": "off",
        "effect/noThrowStatement": "off",
        "effect/noTryCatch": "off"
      }
    },
    {
      "files": ["packages/effect-frame/src/actor/canonical-json.ts"],
      "rules": {
        "effect/noGlobals": "off",
        "effect/noNullish": "off",
        "effect/noRuntimeTypeof": "off"
      }
    },
    {
      "files": ["apps/notes/src/server.ts", "apps/dashboard/src/server.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off"
      }
    },
    {
      "files": ["apps/blog/src/server.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off"
      }
    },
    {
      "files": ["apps/blog/src/prerender.server.ts"],
      "rules": {
        "effect/noGlobals": "off"
      }
    },
    {
      "files": ["apps/notes/src/terminal.tsx"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off"
      }
    },
    {
      "files": [
        "**/*.server.ts",
        "**/*.server.tsx",
        "**/server.ts",
        "**/server.tsx",
        "**/tests/**",
        "**/scripts/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/*.d.ts",
    "**/bin/**",
    "packages/host-durable-object/fixture/worker.js",
    "**/.proof/**",
    "packages/host-durable-object/fixture-contract/worker.js",
    "tooling/dom-bench/.generated/**",
    "tooling/dom-bench/.generated-debug/**",
    "tooling/dom-bench/.generated-debug-o/**",
    "tooling/dom-bench/.turbo/**"
  ]
}
