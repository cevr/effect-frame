{
  "name": "effect-frame-host-durable-object-contract-proof",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "no_bundle": true,
  "durable_objects": {
    "bindings": [{ "name": "HOST", "class_name": "FrameHost" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FrameHost"] }],
}
